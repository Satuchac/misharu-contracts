// ──────────────────── the public inputs must actually enter the equation

/// The statement is "3 × 11 = 33". Claiming a different product with the same
/// proof is the attack a verifier that ignored its inputs would allow.
test rejects_a_different_claimed_output() {
  !verify(vk(), good_proof(), [34, 3])
}

test rejects_a_different_claimed_input() {
  !verify(vk(), good_proof(), [33, 4])
}

test rejects_swapped_inputs() {
  !verify(vk(), good_proof(), [3, 33])
}

// ─────────────────────────── the key and the statement must agree

/// Fewer inputs than IC points would let trailing points contribute nothing, so
/// a proof about a longer statement would verify against a shorter one — the
/// caller choosing which parts of the statement to assert.
test rejects_too_few_inputs() {
  !verify(vk(), good_proof(), [33])
}

test rejects_no_inputs() {
  !verify(vk(), good_proof(), [])
}

test rejects_too_many_inputs() {
  !verify(vk(), good_proof(), [33, 3, 1])
}
