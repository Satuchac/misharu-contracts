// ──────────── bytes that are not a curve point abort, they do not return False
//
// `bls12_381_g1_uncompress` rejects anything off the curve, so a mangled point
// never reaches the pairing. These assert the ABORT: a validator handed junk
// stops, rather than continuing with a point it invented.

test aborts_on_a_malformed_a() fail {
  let bad = proof(#"b0ea7082245a74b0781791130d94de62d1c475d346b213f5b0cd41e89ef4762977b98d78179dcd35bcb9728d44dd7d10", #"aa2b7fadc87be1cbb91a9d261c4f681c57fc90e367b7d610a1697c95d8f6f7af62b8980b629544e93d442ce0c999f29c0fd5a2e81444971f9f02e54cb3088eaa4b80e88b108db857b84e728922781d68c9c4a47d2626ae86b60a33575a0e7227", #"a025d9a1c06349930d2b3cd342562e4724b5dc6b6479d4b4cd91d3f3d0dd97c210f977214b073d79daab8f74fd8633e4")
  verify(vk(), bad, public_inputs())
}

